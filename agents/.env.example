# ============================================
# VYOM AI CLOUD — AGENT ENVIRONMENT VARIABLES
# ============================================
# Copy this file to agents/.env and fill in your values
# ============================================

# OLLAMA (primary LLM — no API keys needed)
# qwen2.5:7b (non-reasoning) — qwen3.5:9b reasoning model returns EMPTY via the LLM path
OLLAMA_MODEL=qwen2.5:7b
# Docker: http://host.docker.internal:11434
# Local:  http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# GROQ API (fallback LLM — leave empty to skip)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# GEMINI API (fallback LLM — leave empty to skip)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# FIREBASE
FIREBASE_PROJECT_ID=timi-childern-stories
# Option A: base64-encoded service account JSON (preferred for CI/Docker)
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option B: path to service account file (used if KEY is empty)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase/serviceAccountKey.json

# YOUTUBE DATA API V3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# YOUTUBE ANALYTICS & REVENUE
YOUTUBE_CPM=8.0

# TIKTOK PUBLISHING
 TIKTOK_CLIENT_KEY=
 TIKTOK_CLIENT_SECRET=
 TIKTOK_ACCESS_TOKEN=
 TIKTOK_OPEN_ID=
 TIKTOK_REFRESH_TOKEN=
 # privacy: PUBLIC_TO_EVERYONE (needs Direct Post audit) | SELF_ONLY (works unaudited)
 TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# INSTAGRAM / FACEBOOK PUBLISHING
# Comma-separated list, e.g. youtube,tiktok,instagram,facebook
PLATFORMS_TO_PUBLISH=youtube,tiktok,facebook
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
# Facebook upload compression (higher = smaller file, default 30; original is CRF 20)
FACEBOOK_CRF=30

# STOCK VIDEO APIS
PEXELS_API_KEY=
PIXABAY_API_KEY=

# TELEGRAM BOT NOTIFICATIONS
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CLOUDFLARE R2 STORAGE
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=vyom-ai-videos

# FFMPEG PATHS (defaults: auto-detected via PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# FEATURE FLAGS
ENABLE_MULTI_LANG=false
MULTI_LANG_CODES=es,fr,de,pt,hi
ENABLE_SUBTITLES=true
# SUBTITLE_MODE: auto (burn for shorts / soft-CC for longs) | burn | cc | both | off
# Keeps a single subtitle track so viewers never see burned text + CC duplicates.
SUBTITLE_MODE=auto
# Set true to allow text-estimated SRT when voice timing is unavailable (falls back).
SUBTITLE_ALLOW_ESTIMATE=false
# AUDIENCE_LEVEL: nontechnical (16+, zero prior knowledge) | general | technical
AUDIENCE_LEVEL=nontechnical
# FONT for drawtext CTA/hook overlays (container-safe; macOS dev: /System/Library/Fonts/Helvetica.ttc)
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# Repurposed Shorts: crop genuinely-9:16 (true) vs legacy blurred-pad letterbox (false).
ENABLE_PORTRAIT_SHORTS=true
# LIKE pill CTA overlay near end of shorts+longs.
ENABLE_LIKE_CTA=true
ENABLE_REVIEW_GATE=true
ENABLE_DIRECTOR_REVIEW=true
AUTO_APPROVE_THRESHOLD=80
ENABLE_AUTO_REPLY=true
ENABLE_COMMUNITY_POSTS=false
ENABLE_UPSCALE=false
ENABLE_STOCK_FOOTAGE=true
SCENE_ARCHITECT_MODE=advisory

# SCHEDULING
SCHEDULE_SHORTS_PER_DAY=1
SCHEDULE_LONG_PER_DAY=2
MAX_RETRIES_PER_TOPIC=3
PIPELINE_TIMEOUT_MINUTES=90
# Verified news: mandatory daily slots (1 World short + 1 Nepal short + 1 news long).
# Only articles from hard-coded verified publishers are ever used; nothing is invented.
ENABLE_NEWS=true
# Single 16GB box: max GPU (long-form) videos per day so a heavy day can't crash the container
GPU_VIDEO_BUDGET_PER_DAY=2
NEWS_FRESHNESS_HOURS=48
NEWS_MAX_ITEMS_PER_FEED=20

# BLENDER 3D RENDER SETTINGS
# Samples per render engine pass (higher = better quality, slower)
BLENDER_RENDER_SAMPLES_SHORT=64
BLENDER_RENDER_SAMPLES_LONG=128
BLENDER_RENDER_SAMPLES_DOC=256

# TIER (set to "documentary" for documentary-style long videos)
TIER=
DOCUMENTARY_MAX_DURATION=600

# LTX VIDEO MODEL (16GB Mac optimized)
VIDEO_MODEL=ltx
LTX_MODEL_DIR=~/ltx-models
LTX_ENGINE=mlx
LTX_LOW_RAM=true
LTX_PIPELINE_MODE=distilled
LTX_GEMMA_MODEL=mlx-community/gemma-3-12b-it-4bit
LTX_DISTILLED_LORA=ltx-2.3-22b-distilled-lora-384-1.1.safetensors
LTX_MIN_FRAMES=65
LTX_MAX_FRAMES=145
LTX2_DIT_EVAL_EVERY=12
LTX2_GEMMA_EVAL_EVERY=2

# VOICE
VOICE_PROVIDER=kokoro
GOOGLE_APPLICATION_CREDENTIALS=

# KOKORO TTS (local, free, no API key needed)
KOKORO_VOICE=af_bella
KOKORO_REPO_ID=hexgrad/Kokoro-82M

# EDGE TTS (online, used as fallback for timing)

# SFX (sound effects mixed into final audio)
SFX_ENABLED=true
SFX_VOLUME_DB=-12

# COMPANION PAGES (self-contained HTML pages uploaded to R2 per video)
ENABLE_COMPANION_PAGES=true

# SENTRY
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# VISUAL QA (frame-level quality checks after compositing)
ENABLE_VISUAL_QA=true
QA_BLACK_THRESHOLD=0.35
QA_FREEZE_THRESHOLD=0.1
QA_BLUR_THRESHOLD=100.0
QA_MAX_RETRIES=2

# CLOUD VIDEO FALLBACK (set API keys to enable Replicate.com or fal.ai video gen)
REPLICATE_API_KEY=your_replicate_api_key_here
FAL_KEY=
CLOUD_VIDEO_PROVIDER=replicate

# PIPELINE CONFIG
USE_ANIMATION_ENGINE=true
LONG_MAX_DURATION=600
LONG_MIN_NARRATION_WORDS=360
NEWS_LONG_MIN_NARRATION_WORDS=450
SHORTS_MAX_DURATION=180
MIN_VIRALITY_SCORE=30
SLOT=
# Route agents to a specific LLM provider. "ollama" (default, free), "gemini" (paid).
# Example: {"scriptwriter": "gemini"} routes one agent to Gemini, all others to Ollama.
AGENT_LLM_ROUTES={"*": "ollama"}
# OLLAMA_MODEL_ROUTES: JSON dict of agent_id -> Ollama model tag. All agents use the
# default OLLAMA_MODEL (qwen2.5:7b); Gemini is the automatic fallback on empty/invalid
# LLM responses. Kept explicit here so every agent is routable.
OLLAMA_MODEL_ROUTES={"storyboard": "qwen2.5:7b", "virality_analyst": "qwen2.5:7b", "director": "qwen2.5:7b", "animator": "qwen2.5:7b", "metadata": "qwen2.5:7b", "composer": "qwen2.5:7b"}
# Slack webhook for operational alerts (pipeline health, staleness, missed-slot, resource warnings).
SLACK_WEBHOOK_URL=
# Persistent (host-mounted) LTX render cache directory; survives container recreates.
LTX_CACHE_DIR=
USE_MUSICGEN=false

# VISUAL ANNOTATION SYSTEM (Phase 1)
# Animated callouts, steps, definitions, arrows, highlights, counters on video frames
ENABLE_ANNOTATIONS=true
ENABLE_ANNOTATIONS_CALLOUT=true
ENABLE_ANNOTATIONS_STEP=true
ENABLE_ANNOTATIONS_DEFINITION=true
ENABLE_ANNOTATIONS_ARROW=false
ENABLE_ANNOTATIONS_HIGHLIGHT=true
ENABLE_ANNOTATIONS_COUNTER=false

# 2D DIAGRAM RENDERER (Phase 2)
# PIL-based flow/bar/comparison/timeline/architecture diagrams
ENABLE_DIAGRAMS=true

# AUDIO SFX (Phase 3)
# Emphasis dings (880Hz) at key terms, whooshes (200→2000Hz) at scene boundaries
ENABLE_SFX=true

# MID-ROLL CTA (Phase 4)
# "Subscribe" overlay at 60% video mark
ENABLE_MIDROLL_CTA=true
